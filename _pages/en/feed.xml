---
layout: null
permalink: /en/feed.xml
lang: en
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>English editions of qscqesze's articles</subtitle>
  <link href="{{ '/en/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/en/' | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ '/en/' | absolute_url }}</id>
  {% assign english_posts = site.en_posts | sort: 'date' | reverse %}
  {% assign latest_post = english_posts | first %}
  <updated>{% if latest_post %}{{ latest_post.modified | default: latest_post.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author>
    <name>{{ site.author.name | default: site.name | xml_escape }}</name>
  </author>
  {% for post in english_posts limit: 20 %}
  <entry>
    <title>{{ post.title | strip_html | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.modified | default: post.date | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.excerpt | markdownify | xml_escape }}</summary>
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | markdownify | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
