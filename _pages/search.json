---
layout: null
permalink: /search.json
sitemap: false
---
[
{% assign searchable_posts = site.posts | concat: site.legacy %}
{% for post in searchable_posts %}
  {
    "title": {{ post.title | strip_html | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "excerpt": {{ post.excerpt | markdownify | strip_html | strip_newlines | jsonify }},
    "categories": {{ post.categories | default: empty | jsonify }},
    "tags": {{ post.tags | default: empty | jsonify }},
    "content": {{ post.content | markdownify | strip_html | strip_newlines | jsonify }},
    "legacy": {% if post.collection == 'legacy' %}true{% else %}false{% endif %}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
